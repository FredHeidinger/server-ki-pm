# Nach /etc/kipm/kipm.env kopieren, Rechte 0640 root:kipm. Werte einsetzen, Datei nie ins Repository.
KIPM_DEBUG=0
KIPM_DATEN_DIR=/var/lib/kipm
KIPM_ALLOWED_HOSTS=kipm.home.arpa
# Geheimnis mit: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
KIPM_SECRET_KEY=HIER-EINSETZEN
# Hinter dem Reverse-Proxy: HTTPS wird von Caddy terminiert
KIPM_HINTER_PROXY=1
# Projektakte: Uploads erst nach nachgewiesenem Speicher, Prüfdienst und Sicherung einschalten.
KIPM_UPLOADS_AKTIV=0
# Schadsoftwareprüfung: leer = keine (Uploads bleiben in Quarantäne), clamdscan = ClamAV-Dienst
KIPM_SCANNER=
# GitHub App: ID und Pfad zur privaten Schlüsseldatei (0600 kipm), nie im Repository
#KIPM_GITHUB_APP_ID=
#KIPM_GITHUB_APP_SCHLUESSEL=/etc/kipm/github-app.pem
